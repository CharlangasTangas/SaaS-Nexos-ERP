# ─────────────────────────────────────────────────────────────────────────────
# Nexos ERP — Variables de Entorno
# Copiar este archivo a .env y completar los valores requeridos.
#
# Para generar los secrets JWT:
#   openssl rand -base64 32
#
# IMPORTANTE: .env NUNCA debe commitearse al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://lvh.me:3000
API_URL=http://api.lvh.me:4000
ROOT_DOMAIN=lvh.me

# ─── Database (Docker) ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://nexos:nexos@postgres:5432/nexos?schema=public
SHADOW_DATABASE_URL=postgresql://nexos:nexos@postgres:5432/nexos_shadow

# ─── Redis (Docker) ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
JWT_ACCESS_SECRET=<generar con openssl rand -base64 32>
JWT_REFRESH_SECRET=<generar con openssl rand -base64 32>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2

# ─── Storage (MinIO local — S3-compatible) ────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nexos-files
S3_FORCE_PATH_STYLE=true

# ─── Email (Mailhog local — dev/staging) ─────────────────────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@nexos.local

# ─── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=/var/log/nexos/app.log
