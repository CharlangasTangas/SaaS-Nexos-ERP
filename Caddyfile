# Caddyfile — Reverse proxy local para Nexos ERP
# Rutas:
#   *.lvh.me        → web:3000  (frontend Next.js)
#   api.lvh.me      → api:4000  (backend NestJS)
#
# lvh.me es un servicio público gratuito que resuelve *.lvh.me a 127.0.0.1
# No requiere DNS público ni configuración adicional.

# ─── API ──────────────────────────────────────────────────────────────────────
api.lvh.me {
  reverse_proxy api:4000 {
    header_up Host {host}
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
  }
}

# ─── Frontend (wildcard tenant) ───────────────────────────────────────────────
*.lvh.me {
  reverse_proxy web:3000 {
    header_up Host {host}
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
  }
}

# ─── Root domain ──────────────────────────────────────────────────────────────
lvh.me {
  reverse_proxy web:3000 {
    header_up Host {host}
  }
}
